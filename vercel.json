{
  "buildCommand": "node scripts/stamp-build.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/r/:id/og.png", "destination": "/api/og?id=:id" },
    { "source": "/r/:id", "destination": "/api/receipt?id=:id" },
    { "source": "/u/:handle", "destination": "/api/profile?handle=:handle" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/disclaimer", "destination": "/disclaimer.html" }
  ]
}
